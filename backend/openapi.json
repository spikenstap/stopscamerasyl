          },
          "matches": {
            "items": {
              "$ref": "#/components/schemas/ThreatMatch"
            },
            "type": "array",
            "title": "Matches"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "checked",
          "matches"
        ],
        "title": "ThreatIntel"
      },
      "ThreatMatch": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "threatType": {
            "type": "string",
            "title": "Threattype"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "source",
          "threatType"
        ],
        "title": "ThreatMatch"
      },
      "TokenRequest": {
        "properties": {
          "deviceId": {
            "type": "string",
