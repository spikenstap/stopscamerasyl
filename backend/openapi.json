            "title": "Deviceid"
          },
          "deviceSecret": {
            "type": "string",
            "title": "Devicesecret"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "deviceId",
          "deviceSecret"
        ],
        "title": "RegisterResponse"
      },
      "ReputationResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unknown",
              "clear",
              "flagged"
            ],
            "title": "Status"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "expiresAt": {
            "type": "integer",
            "title": "Expiresat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "confidence",
          "confirmed",
          "source",
          "reason",
          "expiresAt"
        ],
        "title": "ReputationResponse"
      },
      "ThreatIntel": {
        "properties": {
          "checked": {
            "type": "boolean",
