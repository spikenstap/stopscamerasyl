              "ios"
            ],
            "title": "Platform"
          },
          "appVersion": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Appversion"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "platform",
          "appVersion"
        ],
        "title": "RegisterRequest"
      },
      "RegisterResponse": {
        "properties": {
          "deviceId": {
            "type": "string",
