        "properties": {
          "phoneNumber": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Phonenumber"
          },
          "category": {
            "type": "string",
            "enum": [
              "advertising",
              "suspectedFraud",
              "harassment",
              "other"
