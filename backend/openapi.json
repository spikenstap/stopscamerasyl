  "components": {
    "schemas": {
      "AcceptedResponse": {
        "properties": {
          "accepted": {
            "type": "boolean",
            "title": "Accepted"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "accepted"
        ],
        "title": "AcceptedResponse"
      },
      "AnalyzeRequest": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "url",
              "qr",
              "phone"
            ],
            "title": "Type"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content"
          },
          "language": {
            "type": "string",
            "enum": [
              "ru",
              "kk"
            ],
            "title": "Language"
          },
          "localSignals": {
            "additionalProperties": true,
            "type": "object",
            "title": "Localsignals"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "content",
          "language"
        ],
        "title": "AnalyzeRequest"
      },
      "AnalyzeResponse": {
        "properties": {
          "riskScore": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Riskscore"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "riskLevel": {
            "type": "string",
            "enum": [
              "safe",
              "low",
              "medium",
              "high",
              "critical"
            ],
            "title": "Risklevel",
            "default": "safe"
          },
          "isScam": {
            "type": "boolean",
            "title": "Isscam"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Reasons"
          },
          "recommendations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Recommendations"
          },
          "threatIntel": {
            "$ref": "#/components/schemas/ThreatIntel"
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "title": "Requestid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "riskScore",
          "confidence",
          "isScam",
          "category",
          "summary",
          "reasons",
          "recommendations",
          "threatIntel",
          "requestId"
        ],
        "title": "AnalyzeResponse"
      },
      "DomainRequest": {
        "properties": {
          "domain": {
            "type": "string",
            "maxLength": 253,
            "minLength": 1,
            "title": "Domain"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "domain"
        ],
        "title": "DomainRequest"
      },
      "DomainWrite": {
        "properties": {
